<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Real-time Text & Image Share - Private, Instant, No Storage</title>
    <link rel="stylesheet" href="/style.css" />
    <script src="/qrcode.min.js"></script>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="64x64" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- SEO Meta Tags for Real-time Text & Image Share -->
    <meta
      name="title"
      content="Real-time Text & Image Share - Private, Instant, No Storage"
    />
    <meta
      name="description"
      content="A minimalist web app for sharing text and images between devices in real-time, privately, and without persistent storage. No accounts, no tracking, no server-side storage. Share via unique URL and QR code."
    />
    <meta
      name="keywords"
      content="real-time, text share, image share, private, secure, no storage, web app, QR code, instant, in-memory, Node.js, privacy, minimalist, cross-device, WebSocket"
    />
    <meta name="author" content="andygock" />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Real-time Text & Image Share - Private, Instant, No Storage"
    />
    <meta
      property="og:description"
      content="Share text and images instantly and privately between devices. No persistent storage. Unique URL and QR code for easy access."
    />
    <meta property="og:url" content="https://ts.gock.net/" />
    <meta property="og:image" content="https://ts.gock.net/og-image.jpg" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Real-time Text & Image Share - Private, Instant, No Storage"
    />
    <meta
      name="twitter:description"
      content="A minimalist, privacy-focused web app for instant text and image sharing between devices. No accounts, no tracking, no storage."
    />
    <meta name="twitter:image" content="https://ts.gock.net/og-image.jpg" />
  </head>
  <body
    data-room-id="<%= roomId %>"
    data-max-image-upload-size="<%= maxImageUploadSize || 10485760 %>"
  >
    <div class="container">
      <header id="header" class="app-header">
        <div class="brand">
          <img
            class="brand-mark"
            src="/apple-touch-icon.png"
            alt=""
            aria-hidden="true"
          />
          <h1>Text Share</h1>
          <span class="header-divider" aria-hidden="true"></span>
          <span class="muted header-caption"
            >Text & images, between devices</span
          >
        </div>
        <nav aria-label="Room navigation">
          <a class="button button-secondary" href="/join">Join with PIN</a>
          <a class="button" href="/"
            >New room <span aria-hidden="true">+</span></a
          >
        </nav>
      </header>
      <div class="workspace-heading">
        <div><h2>Your shared room</h2></div>
        <span
          id="h1-user-count"
          class="h1-user-count"
          aria-live="polite"
        ></span>
      </div>
      <div id="top">
        <aside id="top-left-controls" aria-label="Room details">
          <section class="panel share-panel">
            <div class="panel-heading">
              <h2>Connect a device</h2>
              <span class="badge">Room</span>
            </div>
            <div class="qr-row">
              <div
                id="qrcode"
                role="img"
                aria-label="Scan to open this room"
              ></div>
              <p class="muted">Scan the QR code or share this page’s URL.</p>
            </div>
            <div id="pin-share">
              <button class="button button-secondary" id="generate-pin">
                Generate sharing PIN
              </button>
              <span id="pin-value" class="pin-value"></span>
              <span id="pin-expires" class="pin-expires"></span>
              <div id="incoming-requests"></div>
            </div>
          </section>
          <section class="users-info panel">
            <div class="panel-heading">
              <h2>Connected devices</h2>
              <span id="userCount" class="badge">0</span>
            </div>
            <ul id="userList"></ul>
            <p class="muted privacy-note">
              Your IP address is visible to others in this room.
            </p>
          </section>
        </aside>
        <main id="text-content">
          <section class="panel editor-panel" aria-labelledby="text-heading">
            <div class="panel-heading">
              <h2 id="text-heading">
                <label for="sharedText">Shared text</label>
              </h2>
              <span class="muted">Syncs as you type</span>
            </div>
            <textarea
              id="sharedText"
              placeholder="Type or paste something to share…"
              spellcheck="false"
            ></textarea>
            <div class="textarea-barcode-controls">
              <span class="muted editor-hint"
                >Plain text · Real-time sharing</span
              >
              <button class="button button-secondary" id="generate-barcodes">
                Text to QR codes
              </button>
              <button
                id="close-barcodes"
                class="button-secondary"
                title="Hide QR codes"
                aria-label="Hide QR codes"
              >
                ✕
              </button>
            </div>
          </section>

          <div id="generalError" class="general-error" role="alert"></div>
          <div class="barcodes"></div>
          <section id="image-share" class="panel">
            <div class="panel-heading">
              <h2>Images</h2>
              <span class="muted">Resized on receipt</span>
            </div>
            <form id="imageUploadForm" enctype="multipart/form-data">
              <input
                type="file"
                id="imageInput"
                name="image"
                accept="image/png,image/jpeg,image/webp"
              />
              <div id="dropArea">
                <span class="upload-icon" aria-hidden="true">↑</span>
                <div>
                  <span
                    >Drop an image here, or
                    <button type="button" id="selectImageBtn">
                      browse files
                    </button></span
                  >
                  <p class="muted">
                    PNG, JPEG or WebP · Up to <%= Math.round((maxImageUploadSize
                    || 10485760) / 1048576) %> MiB
                  </p>
                </div>
              </div>
            </form>
            <!-- Upload status indicator -->
            <div id="uploadStatus" class="upload-status" role="status"></div>
            <div id="uploadError" class="upload-error" role="alert"></div>
            <progress
              id="uploadProgressBar"
              class="upload-progress-bar"
              max="100"
              value="0"
              aria-label="Image upload progress"
            ></progress>
            <div id="sharedImages"></div>
          </section>
          <section class="detected-links-section panel" aria-live="polite">
            <div class="panel-heading">
              <h2 class="detected-links-label">Detected links</h2>
              <span class="muted">From shared text</span>
            </div>
            <div
              id="detected-links"
              class="detected-links-list"
              data-empty="true"
            >
              No clickable links detected.
            </div>
          </section>
        </main>
      </div>
      <footer class="footer">
        <span>Instant sharing. No account needed.</span>
        <p>
          <a
            href="https://github.com/andygock/text-share"
            target="_blank"
            rel="noopener noreferrer"
            >GitHub <span aria-hidden="true">↗</span></a
          >
        </p>
      </footer>
    </div>

    <script src="/app.js"></script>
  </body>
</html>
